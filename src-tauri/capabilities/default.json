{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Main window capability for Kinglet",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "window-state:default",
    "dialog:default",
    "opener:default",
    "updater:default",
    "fs:allow-read-text-file",
    "fs:allow-read-file",
    "fs:allow-write-text-file",
    "fs:allow-watch",
    "fs:allow-unwatch"
  ]
}
